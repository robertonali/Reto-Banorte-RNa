#!/bin/sh
# Bloquear commits con datos personales (ver scripts/check_sensitive.py).
if command -v uv >/dev/null 2>&1; then
    exec uv run --no-sync python scripts/check_sensitive.py
elif command -v python >/dev/null 2>&1; then
    exec python scripts/check_sensitive.py
else
    exec python3 scripts/check_sensitive.py
fi
