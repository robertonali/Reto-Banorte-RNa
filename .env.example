# Copiar este archivo a .env y llenar los valores. El .env real nunca se sube a git.

# local: permite correr sin AGENT_API_KEY. En Render es "production" (el valor por defecto).
ENVIRONMENT=local
LOG_LEVEL=INFO

# Key que la plataforma del reto manda a mi endpoint (Authorization: Bearer <key>).
# Generarla con: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Keys de los proveedores (solo las usa el backend).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres para previous_response_id. Vacío = conversaciones en memoria.
# Con docker compose: postgresql://agente:agente@localhost:5432/agente_cv
DATABASE_URL=

# Perfil (fuera del repo). En Render: /etc/secrets/profile.yaml
PROFILE_PATH=private/profile.yaml

# Agente: claude-* usa Anthropic, gpt-* usa OpenAI. El respaldo responde si el principal falla.
LLM_MODEL=claude-haiku-5-5
LLM_FALLBACK_MODEL=gpt-6.1-sol
LLM_EFFORT=low
CONTEXT_STRATEGY=completo
MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_SECONDS=60

# Límites
MAX_MESSAGE_CHARS=4000
MAX_HISTORY_MESSAGES=40
RATE_LIMIT_PER_MINUTE=30
